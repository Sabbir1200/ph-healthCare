<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="color-scheme" content="light dark" />
  <meta name="supported-color-schemes" content="light dark" />
  <title>Sign In to Your Healthcare Account</title>
</head>

<body style="margin:0; padding:0; background-color:#f4f7fb; font-family:Arial, Helvetica, sans-serif; -webkit-text-size-adjust:100%; -ms-text-size-adjust:100%;">

  <!-- Hidden Preheader Text (Shows in Inbox Preview) -->
  <div style="display:none; max-height:0; overflow:hidden;">
    Your Healthcare sign-in verification code is <%= OTP %>. Valid for 5 minutes.
  </div>

  <table width="100%" cellpadding="0" cellspacing="0" border="0" role="presentation"
    style="background-color:#f4f7fb; padding:40px 15px;">
    <tr>
      <td align="center">

        <table width="100%" cellpadding="0" cellspacing="0" border="0" role="presentation"
          style="max-width:550px; background-color:#ffffff; border-radius:12px; border:1px solid #e2e8f0; overflow:hidden;">

          <!-- Header -->
          <tr>
            <td align="center"
              style="background-color:#0d9488; padding:30px 20px;">
              <h1 style="margin:0; color:#ffffff; font-size:26px; font-weight:bold;">
                Healthcare
              </h1>
              <p style="margin:8px 0 0; color:#e0f2f1; font-size:14px;">
                Your Health, Our Priority
              </p>
            </td>
          </tr>

          <!-- Content -->
          <tr>
            <td style="padding:35px 30px; color:#334155;">

              <h2 style="margin:0 0 15px; color:#0f172a; font-size:22px;">
                Sign In to Your Account
              </h2>

              <p style="font-size:15px; line-height:1.7; margin:0 0 15px;">
                Hello,
              </p>

              <p style="font-size:15px; line-height:1.7; margin:0 0 25px;">
                We received a sign-in request for your Healthcare account.
                Use the verification code below to complete your login.
              </p>

              <!-- OTP Box -->
              <table width="100%" cellpadding="0" cellspacing="0" border="0" role="presentation">
                <tr>
                  <td align="center"
                    style="background-color:#f0fdfa; border:1px dashed #0d9488; border-radius:10px; padding:25px 10px;">

                    <p style="margin:0 0 10px; color:#64748b; font-size:12px; font-weight:bold; letter-spacing:1px;">
                      YOUR SIGN-IN CODE
                    </p>

                    <p style="margin:0; color:#0d9488; font-size:34px; font-weight:bold; letter-spacing:10px; padding-left:10px; font-family:'Courier New', Courier, monospace;">
                      <%= OTP %>
                    </p>

                  </td>
                </tr>
              </table>

              <p style="font-size:14px; line-height:1.7; margin:25px 0 10px;">
                <strong>Important:</strong> This OTP is valid for
                <strong>5 minutes</strong> only.
              </p>

              <p style="font-size:14px; line-height:1.7; margin:0;">
                If you did not attempt to sign in, please ignore this email
                and consider updating your password to keep your account secure.
              </p>

            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td align="center"
              style="background-color:#f8fafc; padding:22px 20px; border-top:1px solid #e2e8f0;">

              <p style="margin:0 0 8px; color:#64748b; font-size:13px;">
                Thank you for choosing Healthcare.
              </p>

              <p style="margin:0; color:#94a3b8; font-size:12px;">
                &copy; <%= new Date().getFullYear() %> Healthcare. All rights reserved.
              </p>

              <p style="margin:10px 0 0; color:#94a3b8; font-size:11px;">
                This is an automated email. Please do not reply.
              </p>

            </td>
          </tr>

        </table>

      </td>
    </tr>
  </table>

</body>
</html>